#!/usr/bin/env bash

set -u

command_name="$(basename "$0")"

# Get the currently checked-out branch.
current_branch() {
    git symbolic-ref --quiet --short HEAD 2>/dev/null
}

# Set $branch or exit. Not called via $(...), so exit ends the script.
require_branch() {
    branch="$(current_branch)" || {
        echo "Error: not on a Git branch." >&2
        exit 1
    }
}

usage() {
    cat <<'EOF'
git stash, but per branch.

Usage:
  wip [message]   stash all changes (incl. untracked) for the current branch
  unwip           restore the newest WIP of the current branch
  wips            list all branches with their WIP count and names
  -h, --help      show this help
EOF
}

if [[ "${1-}" == -h || "${1-}" == --help ]]; then
    usage
    exit 0
fi

case "$command_name" in

    # ---------------------------------------------------------------
    # wip "description"
    #
    # Stash everything, including untracked files.
    # The branch name is stored in our own marker so we can reliably
    # associate this WIP with the branch later.
    # ---------------------------------------------------------------
    wip)
        require_branch

        if [[ -z "$(git status --porcelain)" ]]; then
            echo "Nothing to WIP."
            exit 0
        fi

        message="${*:-unnamed checkpoint}"

        git stash push -u -m "WIP::$branch::$message"
        ;;


    # ---------------------------------------------------------------
    # wips
    #
    # List every local branch (and any branch that has WIPs) with its
    # WIP count. If any WIP of a branch is named, list all of them,
    # numbering the unnamed ones.
    # Subjects look like "On <branch>: WIP::<branch>::<message>".
    # ---------------------------------------------------------------
    wips)
        counts="$({
            git for-each-ref --format='branch::%(refname:short)' refs/heads
            git stash list --format='%s'
        } | awk -F'::' '
            $1 == "branch" { n[$2] += 0; next }
            /^On [^:]*: WIP::/ {
                b = $2
                m = $0
                sub(/^On [^:]*: WIP::[^:]*::/, "", m)
                n[b]++
                if (m == "unnamed checkpoint") u[b]++
                else named[b] = (b in named ? named[b] "; " : "") m
            }
            END {
                for (b in n) {
                    line = sprintf("%-20s %d %s", b, n[b], n[b] == 1 ? "wip" : "wips")
                    if (b in named) {
                        list = named[b]
                        for (i = 1; i <= u[b]; i++) list = list "; unnamed checkpoint " i
                        line = line ": " list
                    }
                    print line
                }
            }
        ' | sort)"

        echo "${counts:-No WIPs.}"
        ;;


    # ---------------------------------------------------------------
    # unwip
    #
    # Restore the newest WIP belonging to the current branch.
    #
    # --index restores the staged/unstaged state as closely as
    # possible to how it was when `wip` was called.
    # ---------------------------------------------------------------
    unwip)
        require_branch
        marker="WIP::$branch::"
        ref=""

        while IFS=$'\t' read -r stash_ref subject; do
            if [[ "$subject" == *"$marker"* ]]; then
                ref="$stash_ref"
                break
            fi
        done < <(git stash list --format='%gd%x09%s')

        if [[ -z "$ref" ]]; then
            echo "No WIP found for branch '$branch'."
            exit 1
        fi

        echo "Restoring $ref for branch '$branch'..."
        git stash pop --index "$ref"
        ;;


    *)
        echo "Error: call this script as wip, wips, or unwip." >&2
        usage >&2
        exit 1
        ;;
esac
