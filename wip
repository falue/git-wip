#!/usr/bin/env bash

set -u

command_name="$(basename "$0")"

# Get the currently checked-out branch.
current_branch() {
    git symbolic-ref --quiet --short HEAD 2>/dev/null
}

# Set $branch or exit. Not called via $(...), so exit ends the script.
require_branch() {
    branch="$(current_branch)" || {
        echo "Error: not on a Git branch." >&2
        exit 1
    }
}

usage() {
    cat <<'EOF'
git stash, but per branch.

Usage:
  wip [message]   stash all changes (incl. untracked) for the current branch
  unwip           restore the newest WIP of the current branch
  wips            list all branches with their WIP count and names
  wips -d         delete all WIPs of the current branch (also --delete)
  -h, --help      show this help
EOF
}

if [[ "${1-}" == -h || "${1-}" == --help ]]; then
    usage
    exit 0
fi

case "$command_name" in

    # ---------------------------------------------------------------
    # wip "description"
    #
    # Stash everything, including untracked files.
    # The branch name is stored in our own marker so we can reliably
    # associate this WIP with the branch later.
    # ---------------------------------------------------------------
    wip)
        require_branch

        if [[ -z "$(git status --porcelain)" ]]; then
            echo "Nothing to WIP."
            exit 0
        fi

        if [[ $# -gt 0 ]]; then
            message="$*"
        else
            # Number = highest existing unnamed number of this branch + 1.
            prefix="WIP::$branch::unnamed checkpoint "
            last="$(git stash list --format='%s' | awk -v p="$prefix" '
                i = index($0, p) { v = substr($0, i + length(p)) + 0; if (v > max) max = v }
                END { print max + 0 }
            ')"
            message="unnamed checkpoint $((last + 1))"
        fi

        git stash push -u -m "WIP::$branch::$message"
        ;;


    # ---------------------------------------------------------------
    # wips
    #
    # List every local branch with its WIP count (WIPs of deleted
    # branches are ignored). If any WIP of a branch is named, list all
    # of them in unwip order (newest first).
    # On a terminal, the next one unwip restores is green, ">" is grey.
    # Subjects look like "On <branch>: WIP::<branch>::<message>".
    #
    # wips -d / --delete drops all WIPs of the current branch.
    # ---------------------------------------------------------------
    wips)
        if [[ "${1-}" == -d || "${1-}" == --delete ]]; then
            require_branch
            marker="WIP::$branch::"
            n=0

            while IFS=$'\t' read -r stash_ref hash subject; do
                if [[ "$subject" == *"$marker"* ]]; then
                    refs[n]="$stash_ref" hashes[n]="$hash" names[n]="${subject#*"$marker"}"
                    n=$((n + 1))
                fi
            done < <(git stash list --format='%gd%x09%H%x09%s')

            if (( n == 0 )); then
                echo "No WIPs for branch '$branch'."
                exit 0
            fi

            # Oldest first, so the remaining stash@{N} numbers don't shift.
            for (( i = n - 1; i >= 0; i-- )); do
                git stash drop --quiet "${refs[i]}"
                echo "Deleted ${names[i]} (get it back: git stash apply ${hashes[i]})"
            done
            exit 0
        fi

        green="" grey="" reset=""
        if [[ -t 1 ]]; then
            green=$'\e[32m' grey=$'\e[90m' reset=$'\e[0m'
        fi

        counts="$({
            git for-each-ref --format='branch::%(refname:short)' refs/heads
            git stash list --format='%s'
        } | awk -F'::' -v green="$green" -v grey="$grey" -v reset="$reset" '
            $1 == "branch" { n[$2] += 0; next }
            /^On [^:]*: WIP::/ {
                b = $2
                if (!(b in n)) next
                m = $0
                sub(/^On [^:]*: WIP::[^:]*::/, "", m)
                if (m !~ /^unnamed checkpoint( [0-9]+)?$/) named[b] = 1
                list[b] = n[b]++ ? list[b] grey " > " reset m : green m reset
            }
            END {
                for (b in n) {
                    line = sprintf("%-20s %d %s", b, n[b], n[b] == 1 ? "wip" : "wips")
                    if (b in named) line = line ": " list[b]
                    print line
                }
            }
        ' | sort)"

        echo "${counts:-No WIPs.}"
        ;;


    # ---------------------------------------------------------------
    # unwip
    #
    # Restore the newest WIP belonging to the current branch.
    #
    # Clean tree: --index restores the staged/unstaged state as it
    # was when `wip` was called.
    # Local changes: the WIP is merged on top, and all changes end up
    # unstaged. On conflict, markers are written and the WIP is dropped.
    # ---------------------------------------------------------------
    unwip)
        require_branch
        marker="WIP::$branch::"
        ref=""

        while IFS=$'\t' read -r stash_ref subject; do
            if [[ "$subject" == *"$marker"* ]]; then
                ref="$stash_ref"
                break
            fi
        done < <(git stash list --format='%gd%x09%s')

        if [[ -z "$ref" ]]; then
            echo "No WIP found for branch '$branch'."
            exit 1
        fi

        echo "Restoring $ref for branch '$branch'..."

        # Git only merges a stash into staged changes, so with local
        # changes stage them, pop, and unstage everything again.
        index_opt="--index"
        if ! git diff --quiet HEAD; then
            index_opt=""
            git add -u
        fi

        git stash pop --quiet $index_opt "$ref"
        status=$?

        # Conflict: git applied the WIP with markers but kept it.
        # Drop it, so the next unwip takes the one before.
        if (( status != 0 )) && [[ -n "$(git ls-files -u)" ]]; then
            echo "Conflict: WIP dropped anyway, resolve the markers. To get it back: git stash apply $(git rev-parse "$ref")"
            git stash drop --quiet "$ref"
        fi

        if (( status != 0 )) || [[ -z "$index_opt" ]]; then
            git reset -q
        fi

        git status --short
        exit "$status"
        ;;


    *)
        echo "Error: call this script as wip, wips, or unwip." >&2
        usage >&2
        exit 1
        ;;
esac
